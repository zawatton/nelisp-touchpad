      (extern-call Shell_NotifyIconW action n))))
 (defun set_state (ctx desired)
   (let ((before (read_state ctx)) (p (+ ctx 1408)) (i 0) (state -1))
     (if (= before desired) 1
       (if (< before 0) 0
         (seq
          ;; Windows Shell's touchpad command: Ctrl+Win+F24. Send a single
          ;; complete down/up sequence; verify the real OS state afterwards.
          (extern-call memset p 0 240)
          (while (< i 6)
            (seq
             (ptr-write-u32 (+ p (* i 40)) 0 1)
             (ptr-write-u16 (+ p (* i 40)) 8
                            (if (or (= i 0) (= i 5)) 17
                              (if (or (= i 1) (= i 4)) 91 135)))
             (ptr-write-u32 (+ p (* i 40)) 12 (if (> i 2) 2 0))
             (setq i (+ i 1))))
          (if (= (extern-call SendInput 6 p 40) 6)
            (seq
             (setq i 0)
